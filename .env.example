# AbuseShield Next.js Full-Stack Database & Server Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# 1. LOCAL DEVELOPMENT (SQLite - Default)
# ============================================================================
# Local development uses embedded SQLite (node:sqlite WAL mode, zero external deps).
# To use Neon PostgreSQL in production (or locally), set DB_DRIVER=postgres and
# USE_SQLITE=false, then provide your Neon DATABASE_URL below.
DB_DRIVER=sqlite
USE_SQLITE=true
SQLITE_PATH=data/abuseshield.sqlite

# ============================================================================
# 2. PRODUCTION DATABASE (Neon Serverless PostgreSQL + Prisma ORM)
# ============================================================================
# Neon Pooled Connection String (used by Prisma Client & Serverless Pool):
DATABASE_URL="postgresql://neondb_owner:password@ep-cool-darkness-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Optional Neon Direct Connection String (for Prisma migrations / db push):
# DIRECT_URL="postgresql://neondb_owner:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional Pool Tuning
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

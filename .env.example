# AbuseShield Production & Local Database Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Connection (Production & Local WSL Docker)
DATABASE_URL=postgres://abuseshield:abuseshield_secret@localhost:5432/abuseshield_db

# Connection Pool Tuning
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Fallback SQLite path if DATABASE_URL is not set
# SQLITE_PATH=packages/data/abuseshield.sqlite

{
  "name": "tct-shield",
  "version": "2.0.0",
  "private": true,
  "description": "TCT Shield — Lightweight Device Fingerprint & Free-Tier Abuse Detection Platform (Next.js Full-Stack + Neon PostgreSQL + Prisma + Local SQLite)",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "bun run build:sdk && prisma generate && next build",
    "build:sdk": "node scripts/build-sdk.mjs",
    "start": "next start --port 3000",
    "lint": "eslint",
    "test": "bun test",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:seed": "node -e \"fetch('http://localhost:3000/api/v1/simulate/scenario', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ scenario: 'seed_demo_data' }) }).then(r => r.json()).then(console.log)\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^0.475.0",
    "next": "16.4.3",
    "pg": "^8.13.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "esbuild"
  ]
}
